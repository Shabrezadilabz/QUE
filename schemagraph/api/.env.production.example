# Que API — production / free-pilot / paid-POC environment
# Free stack walkthrough: ../docs/DEPLOY-FREE.md
# CEO surfaces: ../docs/CEO-P0-OUTCOME-SHIP.md

## Database (Neon free or any Postgres + pgvector)
DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require

## Required in production (`QUE_ENV=production` or `NODE_ENV=production`)
QUE_SECRETS_KEY=replace-with-32plus-random-chars
QUE_ATTESTATION_HMAC_SECRET=replace-with-random-hmac-secret
QUE_CORS_ORIGINS=https://your-app.vercel.app

## Public URLs (Slack/Teams Approve buttons + redirects)
QUE_APP_URL=https://your-app.vercel.app
QUE_PUBLIC_API_URL=https://your-api.onrender.com
# QUE_JOIN_ACTION_HMAC_SECRET=  # optional; falls back to attestation/secrets key

## Slack interactive signing (optional but recommended when using /webhooks/slack/interactions)
# SLACK_SIGNING_SECRET=

## Auth
# STITCH_AUTH_DISABLED must NOT be true in production (boot will refuse)
# Free pilot: seed demo users so login works without OIDC
QUE_SEED_DEMO_USERS=true


## OIDC SSO (optional but recommended for POC)
QUE_OIDC_ISSUER=https://your-idp.example.com
QUE_OIDC_CLIENT_ID=
QUE_OIDC_CLIENT_SECRET=
QUE_OIDC_REDIRECT_URI=https://api.example.com/auth/sso/callback
QUE_OIDC_POST_LOGIN_REDIRECT=https://your-app.example.com/auth/callback
QUE_SSO_ALLOWED_DOMAINS=yourcompany.com
QUE_SSO_REQUIRE_INVITE=true
# QUE_SSO_DEFAULT_WORKSPACE_ID=

## Optional
# GITHUB_TOKEN=  (prefer workspace secret in Settings)
# QUE_SAMPLE_SCRUB_SALT=
# PORT=8787

## TLS
# Terminate TLS 1.2+ at the reverse proxy / load balancer in front of this API.
