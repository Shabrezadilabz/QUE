{
  "schema": "shopify",
  "tables": [
    {
      "name": "orders",
      "columns": [
        { "name": "id", "dataType": "bigint", "keyKind": "pk", "samples": ["5001001"] },
        { "name": "customer_id", "dataType": "bigint", "keyKind": "fk", "references": "customers.id", "samples": ["9001"] },
        { "name": "total_price", "dataType": "decimal", "samples": ["2499.00"] },
        { "name": "currency", "dataType": "string", "samples": ["INR"] },
        { "name": "created_at", "dataType": "timestamp", "samples": ["2026-03-01T10:00:00Z"] }
      ]
    },
    {
      "name": "customers",
      "columns": [
        { "name": "id", "dataType": "bigint", "keyKind": "pk", "samples": ["9001"] },
        { "name": "email", "dataType": "email", "keyKind": "unique", "samples": ["buyer@example.in"] },
        { "name": "phone", "dataType": "string", "samples": ["+919876543210"] }
      ]
    },
    {
      "name": "products",
      "columns": [
        { "name": "id", "dataType": "bigint", "keyKind": "pk", "samples": ["7001"] },
        { "name": "title", "dataType": "string", "samples": ["Running shoes"] },
        { "name": "vendor", "dataType": "string", "samples": ["SportEdge"] }
      ]
    }
  ],
  "foreignKeys": [
    { "fromTable": "orders", "fromColumn": "customer_id", "toTable": "customers", "toColumn": "id" }
  ]
}
