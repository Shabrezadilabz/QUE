{
  "name": "stitch-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "seed": "node src/seed.js",
    "migrate": "node scripts/migrate.js",
    "seed:demo": "node scripts/seedDemoWorkspace.js",
    "eval:joins": "node eval/runJoinEval.js",
    "test:privacy": "node eval/runPrivacyTests.js",
    "test:functional": "node eval/runFunctionalTests.js",
    "test:unit": "node eval/runUnitTests.js",
    "test:monk": "node eval/runTemplateMatcherTests.js && node eval/runMetricPackSeedTests.js && node eval/runMonkCertEval.js",
    "test:phase3": "node eval/runDashboardTemplateTests.js && node eval/runHealthScorecardTests.js",
    "test:phase4": "node eval/runPhase4Tests.js",
    "test:smoke": "node eval/smokeE2e.js",
    "test:diligence": "npm run eval:joins && npm run test:privacy && npm run test:functional && npm run test:unit",
    "test:all": "npm run test:diligence && npm run test:smoke",
    "bootstrap:demo-source": "node src/bootstrapDemoSource.js",
    "bootstrap:demo-mongo": "node src/bootstrapDemoMongo.js",
    "bootstrap:demo-mongo-bulk": "node scripts/applyCustomerDemoMongoBulk.js",
    "bootstrap:test-data": "node src/bootstrapTestData.js",
    "fixtures:generate": "node scripts/generateTestFixtures.js",
    "fixtures:tester-excel": "node scripts/generateTesterExcelPack.js",
    "fixtures:sportedge": "node scripts/generateSportedgeFixtures.js",
    "bootstrap:sportedge-pg": "node scripts/bootstrapSportedgePostgres.js",
    "bootstrap:sportedge-mongo": "node scripts/bootstrapSportedgeMongo.js",
    "bootstrap:sportedge-dbx": "node scripts/bootstrapSportedgeDatabricks.js",
    "bootstrap:sportedge-all": "node scripts/bootstrapSportedgeAll.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "mongodb": "^7.5.0",
    "multer": "^2.2.0",
    "pg": "^8.13.3",
    "xlsx": "^0.18.5"
  }
}
